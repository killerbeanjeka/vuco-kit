{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["tokens/*.mjs", "src/**/*.mjs", "test/**/*.mjs", "eslint.config.mjs", "types/*.d.ts"]
}
